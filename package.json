{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "prisma": {
    "schema": "./prisma"
  },
  "scripts": {
    "start": "node ./dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only ./src/server.ts",
    "pm": "npx prisma migrate dev ",
    "pg": "npx prisma generate",
    "generate": "ts-node src/generate-module.js",
    "build": "npx prisma generate && tsc && npx esbuild src/server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "postinstall": "prisma generate",
    "lint:check": "eslint --ignore-path .eslintignore --ext .js,.ts .",
    "lint:fix": "eslint . --fix",
    "prettier:check": "prettier --ignore-path .gitignore --write \"**/*.+(js|ts|json)\"",
    "prettier:fix": "prettier --write .",
    "lint-prettier": "yarn lint:check && yarn prettier:check",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
