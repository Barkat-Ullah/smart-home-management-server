model Activity {
    id          String     @id @default(auto()) @map("_id") @db.ObjectId
    userId      String     @db.ObjectId
    title       String
    description String
    createdAt   DateTime   @default(now())
    updatedAt   DateTime   @updatedAt

    user        User       @relation("UserActivity", fields: [userId], references: [id])

    @@map("activity")
}
