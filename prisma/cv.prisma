model CvChunk {
    id        String   @id @default(auto()) @map("_id") @db.ObjectId
    content   String
    embedding Float[]
    source    String   @default("cv")
    createdAt DateTime @default(now())

    @@index([source])
    @@index([createdAt(sort: Desc)])
    @@map("cv_chunks")
}

model ChatSession {
    id        String        @id @default(auto()) @map("_id") @db.ObjectId
    sessionId String        @unique
    messages  ChatMessage[]
    createdAt DateTime      @default(now())
    updatedAt DateTime      @updatedAt

    @@index([createdAt(sort: Desc)])
    @@map("chat_sessions")
}

model ChatMessage {
    id        String      @id @default(auto()) @map("_id") @db.ObjectId
    role      String
    content   String
    sessionId String
    session   ChatSession @relation(fields: [sessionId], references: [sessionId])
    createdAt DateTime    @default(now())

    @@index([sessionId, createdAt(sort: Asc)])
    @@index([sessionId, role])
    @@map("chat_messages")
}


model Test {
    id          String     @id @default(auto()) @map("_id") @db.ObjectId
    title       String
    description String
    status      TestStatus
    isDeleted   Boolean    @default(false)
    createdAt   DateTime   @default(now())
    updatedAt   DateTime   @updatedAt

    @@index([status, isDeleted])
    @@index([createdAt(sort: Desc)])
    @@map("rest")
}

enum TestStatus {
    Pending
    Complete
}