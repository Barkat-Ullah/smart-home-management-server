model Notification {
    id          String      @id @default(auto()) @map("_id") @db.ObjectId
    receiverId  String      @db.ObjectId
    senderId    String?     @db.ObjectId
    title       String
    body        String
    isRead      Boolean     @default(false)
    referenceId String?
    type        NotifyType?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    //relation
    receiver  User     @relation("Receiver", fields: [receiverId], references: [id])
    sender    User?    @relation("Sender", fields: [senderId], references: [id])

    @@map("notifications")
}

enum NotifyType {
    // Admin
    Support // new support feed post
    Contact
    Report
    FeedAssigned // moderator assigned to a feed
    FeedResponded // feed got a response
    // User
    Message
    FeedComment // someone commented on your feed
    FeedReply // someone replied to your comment
    FeedStatusChanged // feed status updated
    // Medicine
    MedicineDue // time to take medicine
    MedicineMissed // missed a dose
    MedicineRefill // running low on medicine
    PrescriptionAdded // new prescription created
    // Meal
    MealPlanCreated // new weekly meal plan ready
    MealPlanCompleted // weekly plan completed
    MealReminder // time to cook/eat
    // Event
    EventReminder // upcoming event reminder
    EventCancelled
    EventUpdated
    // Payment
    Payment
}
