// ============================================
// ENUMS
// ============================================

enum FinancialStatus {
    Pending
    Complete
}

enum TransactionType {
    Income
    Expense
    Saving
    Investment
}

enum TransactionCategory {
    // Income Categories
    Salary
    Freelance
    Business
    Rental
    Dividend
    Bonus
    OtherIncome

    // Expense Categories
    Housing
    Food
    Transport
    Healthcare
    Education
    Entertainment
    Shopping
    Utilities
    Insurance
    EMI
    OtherExpense

    // Saving / Investment
    SavingsAccount
    FixedDeposit
    StockMarket
    MutualFund
    RealEstate
    Crypto
    OtherInvestment
}

enum GoalStatus {
    Active
    Achieved
    Failed
    Paused
}

enum BudgetPeriod {
    Weekly
    Monthly
    Yearly
}

// ============================================
// MAIN FINANCIAL PROFILE (per user, per month)
// ============================================

model FinancialProfile {
    id              String        @id @default(auto()) @map("_id") @db.ObjectId
    userId          String        @db.ObjectId
    // Period
    month           Int
    year            Int
    totalIncome     Float         @default(0)
    totalExpense    Float         @default(0)
    totalSaving     Float         @default(0)
    totalInvestment Float         @default(0)
    netBalance      Float         @default(0)
    // Meta
    currency        String        @default("BDT")
    notes           String?
    isDeleted       Boolean       @default(false)
    createdAt       DateTime      @default(now())
    updatedAt       DateTime      @updatedAt
    // Relations
    user            User          @relation("UserFinancialProfile", fields: [userId], references: [id])
    transactions    Transaction[]
    budgets         Budget[]
    salaryInfo      SalaryInfo?

    @@index([userId, isDeleted])
    @@index([userId, year, month])
    @@unique([userId, month, year])
    @@map("financial_profiles")
}

// ============================================
// SALARY INFO (monthly)
// ============================================

model SalaryInfo {
    id                 String    @id @default(auto()) @map("_id") @db.ObjectId
    financialProfileId String    @unique @db.ObjectId
    basicSalary        Float
    houseRentAllowance Float     @default(0)
    medicalAllowance   Float     @default(0)
    transportAllowance Float     @default(0)
    bonus              Float     @default(0)
    otherAllowance     Float     @default(0)
    taxDeduction       Float     @default(0)
    providentFund      Float     @default(0)
    netSalary          Float
    salaryDate         DateTime?
    createdAt          DateTime  @default(now())
    updatedAt          DateTime  @updatedAt

    financialProfile FinancialProfile @relation(fields: [financialProfileId], references: [id])

    @@map("salary_info")
}

// ============================================
// TRANSACTIONS (income / expense / saving)
// ============================================

model Transaction {
    id                 String              @id @default(auto()) @map("_id") @db.ObjectId
    userId             String              @db.ObjectId
    financialProfileId String              @db.ObjectId
    title              String
    description        String?
    amount             Float
    type               TransactionType
    category           TransactionCategory
    date               DateTime
    isRecurring        Boolean             @default(false)
    recurringDay       Int?
    tags               String[]            @default([])
    // Reference (e.g. bill photo, receipt)
    files              String?
    isDeleted          Boolean             @default(false)
    createdAt          DateTime            @default(now())
    updatedAt          DateTime            @updatedAt

    user             User             @relation("UserTransactions", fields: [userId], references: [id])
    financialProfile FinancialProfile @relation(fields: [financialProfileId], references: [id])

    @@index([userId, date(sort: Desc)])
    @@index([userId, type])
    @@index([userId, category])
    @@index([financialProfileId])
    @@index([userId, date(sort: Desc), type])
    @@map("transactions")
}

// ============================================
// BUDGET 
// ============================================

model Budget {
    id                 String              @id @default(auto()) @map("_id") @db.ObjectId
    userId             String              @db.ObjectId
    financialProfileId String              @db.ObjectId
    category           TransactionCategory
    period             BudgetPeriod        @default(Monthly)
    limitAmount        Float
    spentAmount        Float               @default(0)
    remainingAmount    Float               @default(0)
    alertThreshold     Float               @default(80)
    isAlertSent        Boolean             @default(false)
    month              Int
    year               Int
    createdAt          DateTime            @default(now())
    updatedAt          DateTime            @updatedAt

    user             User             @relation("UserBudgets", fields: [userId], references: [id])
    financialProfile FinancialProfile @relation(fields: [financialProfileId], references: [id])

    @@index([userId, month, year])
    @@index([financialProfileId])
    @@unique([userId, category, month, year])
    @@map("budgets")
}

// ============================================
// FINANCIAL GOALS
// ============================================

model FinancialGoal {
    id              String     @id @default(auto()) @map("_id") @db.ObjectId
    userId          String     @db.ObjectId
    title           String
    description     String?
    targetAmount    Float
    savedAmount     Float      @default(0)
    remainingAmount Float      @default(0)
    startDate       DateTime
    targetDate      DateTime
    achievedDate    DateTime?
    status          GoalStatus @default(Active)
    priority        Int        @default(1)
    isDeleted       Boolean    @default(false)
    createdAt       DateTime   @default(now())
    updatedAt       DateTime   @updatedAt

    user User @relation("UserGoals", fields: [userId], references: [id])

    @@index([userId, status])
    @@index([userId, targetDate])
    @@map("financial_goals")
}

// ============================================
// FINANCIAL SUMMARY SNAPSHOT
// (weekly/monthly/yearly analytics cache)
// ============================================

model FinancialSnapshot {
    id                String       @id @default(auto()) @map("_id") @db.ObjectId
    userId            String       @db.ObjectId
    period            BudgetPeriod
    startDate         DateTime
    endDate           DateTime
    // Aggregated data
    totalIncome       Float        @default(0)
    totalExpense      Float        @default(0)
    totalSaving       Float        @default(0)
    totalInvestment   Float        @default(0)
    netBalance        Float        @default(0)
    savingRate        Float        @default(0)
    expenseRate       Float        @default(0)
    // Category-wise breakdown
    categoryBreakdown Json?
    weeklyBreakdown   Json?
    createdAt         DateTime     @default(now())
    updatedAt         DateTime     @updatedAt

    user User @relation("UserSnapshots", fields: [userId], references: [id])

    @@index([userId, period, startDate])
    @@index([userId, startDate(sort: Desc)])
    @@map("financial")
}
