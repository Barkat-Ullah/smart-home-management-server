// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum EventStatus {
    Upcoming
    Ongoing
    Completed
    Cancelled
    Postponed
}

enum EventType {
    ForYou
    ForFamilyMember
    ForChild
    ForCareGiver
    ForAll
}

enum EventCategory {
    SchoolDropOff
    SchoolPickUp
    MedicalAppointment
    DentistAppointment
    ParentTeacherMeeting
    Vaccination
    Therapy
    PlayDate
    FamilyOuting
    GroceryShopping
    HouseChore
    BillPayment
    Other
}

enum EventPriority {
    Low
    Medium
    High
    Urgent
}

// ─────────────────────────────────────────────
// EVENT
// ─────────────────────────────────────────────

model Event {
    id              String        @id @default(auto()) @map("_id") @db.ObjectId
    userId          String        @db.ObjectId
    title           String
    description     String?
    location        String?
    meetingLink     String?
    category        EventCategory
    type            EventType
    priority        EventPriority @default(Medium)
    status          EventStatus   @default(Upcoming)
    eventDate       DateTime
    eventTime       String?
    // Reminder
    reminderMinutes Int?
    isReminderSent  Boolean       @default(false)
    files           String?
    notes           String?
    isDeleted       Boolean       @default(false)
    createdAt       DateTime      @default(now())
    updatedAt       DateTime      @updatedAt
    completedAt     DateTime?
    cancelledAt     DateTime?

    // Relations
    createdBy User @relation("UserEvents", fields: [userId], references: [id])

    @@index([userId, isDeleted])
    @@index([userId, eventDate])
    @@index([userId, status])
    @@index([userId, category])
    @@index([eventDate(sort: Desc)])
    @@index([status, eventDate])
    @@map("events")
}
