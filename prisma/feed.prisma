// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum FeedType {
    Bug
    FeatureRequest
    Question
    Complaint
    Feedback
    Other
}

enum FeedStatus {
    Open
    UnderReview
    InProgress
    Resolved
    Closed
    Reopened
}

enum FeedPriority {
    Low
    Medium
    High
    Critical
}

// ─────────────────────────────────────────────
// FEED (Main Post)
// ─────────────────────────────────────────────

model Feed {
    id            String              @id @default(auto()) @map("_id") @db.ObjectId
    userId        String              @db.ObjectId
    title         String
    description   String
    type          FeedType            @default(Other)
    status        FeedStatus          @default(Open)
    priority      FeedPriority        @default(Low)
    tags          String[]
    files         String[]
    isDeleted     Boolean             @default(false)
    isPinned      Boolean             @default(false)
    isLocked      Boolean             @default(false)
    viewCount     Int                 @default(0)
    createdAt     DateTime            @default(now())
    updatedAt     DateTime            @updatedAt
    resolvedAt    DateTime?
    closedAt      DateTime?
    // Relations
    createdBy     User                @relation("UserFeeds", fields: [userId], references: [id])
    assignments   FeedAssignment[]
    comments      FeedComment[]
    reactions     FeedReaction[]
    statusHistory FeedStatusHistory[]

    @@index([userId, status, isDeleted])
    @@index([userId, type])
    @@index([userId, createdAt(sort: Desc)])  // for getMyFeed
    @@index([status, isDeleted, createdAt(sort: Desc)])  // for getFeedList
    @@index([status, priority])
    @@index([createdAt(sort: Desc)])
    @@index([isPinned, createdAt(sort: Desc)])
    @@map("feeds")
}

// ─────────────────────────────────────────────
// ASSIGNMENT (Admin → Moderator assign )
// ─────────────────────────────────────────────

model FeedAssignment {
    id             String    @id @default(auto()) @map("_id") @db.ObjectId
    feedId         String    @db.ObjectId
    moderatorId    String    @db.ObjectId
    assignedBy     String    @db.ObjectId
    note           String?
    isActive       Boolean   @default(true)
    assignedAt     DateTime  @default(now())
    removedAt      DateTime?
    // Relations
    feed           Feed      @relation(fields: [feedId], references: [id])
    moderator      User      @relation("ModeratorAssignments", fields: [moderatorId], references: [id])
    assignedByUser User      @relation("AdminAssignments", fields: [assignedBy], references: [id])

    @@index([feedId, isActive])
    @@index([moderatorId, isActive])
    @@map("feed_assignments")
}

// ─────────────────────────────────────────────
// COMMENT (User/Moderator/Admin)
// ─────────────────────────────────────────────

model FeedComment {
    id          String        @id @default(auto()) @map("_id") @db.ObjectId
    feedId      String        @db.ObjectId
    userId      String        @db.ObjectId
    parentId    String?       @db.ObjectId
    content     String
    attachments String[]
    isDeleted   Boolean       @default(false)
    isEdited    Boolean       @default(false)
    isSolution  Boolean       @default(false)
    createdAt   DateTime      @default(now())
    updatedAt   DateTime      @updatedAt
    // Relations
    feed        Feed          @relation(fields: [feedId], references: [id])
    author      User          @relation("UserComments", fields: [userId], references: [id])
    parent      FeedComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
    replies     FeedComment[] @relation("CommentReplies")

    @@index([feedId, createdAt(sort: Desc)])
    @@index([userId])
    @@index([parentId])
    @@map("feed_comments")
}

// ─────────────────────────────────────────────
// REACTIONS
// ─────────────────────────────────────────────

model FeedReaction {
    id         String   @id @default(auto()) @map("_id") @db.ObjectId
    feedId     String   @db.ObjectId
    userId     String   @db.ObjectId
    isFavorite Boolean  @default(false)
    createdAt  DateTime @default(now())
    //relation
    feed       Feed     @relation(fields: [feedId], references: [id])
    user       User     @relation("UserFeedReactions", fields: [userId], references: [id])

    @@index([feedId])
    @@index([userId])
    @@unique([feedId, userId])
    @@map("feed_reactions")
}

// ─────────────────────────────────────────────
// STATUS HISTORY (Audit Trail)
// ─────────────────────────────────────────────

model FeedStatusHistory {
    id            String     @id @default(auto()) @map("_id") @db.ObjectId
    feedId        String     @db.ObjectId
    changedBy     String     @db.ObjectId
    fromStatus    FeedStatus
    toStatus      FeedStatus
    note          String?
    createdAt     DateTime   @default(now())
    //relation
    feed          Feed       @relation(fields: [feedId], references: [id])
    changedByUser User       @relation("StatusChanges", fields: [changedBy], references: [id])

    @@index([feedId, createdAt(sort: Desc)])
    @@map("feed_status_history")
}
